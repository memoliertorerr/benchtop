{
  "name": "example: pico2w-wifi-webserver",
  "project": "../../projects/pico2w-wifi-webserver.json",
  "firmware": {
    "pico2w": "../../firmware/pico2w/wifi-webserver.uf2"
  },
  "steps": [
    {
      "at": "3s",
      "part": "on",
      "input": {
        "kind": "press"
      }
