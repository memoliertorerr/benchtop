{
  "name": "example: sd-datalogger",
  "project": "../../projects/sd-datalogger.json",
  "firmware": {
    "uno": "../../firmware/uno/sd-datalogger.hex"
  },
  "steps": [
    {
      "at": "700ms",
      "part": "pot1",
      "input": {
