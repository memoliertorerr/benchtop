{
  "version": 1,
  "author": "Benchtop tests",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -60, "left": 150, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 20, "left": 140, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 120, "left": 150, "attrs": { "color": "green" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:2", "r1:2", "green", [] ],
    [ "r1:1", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.3", "black", [] ],
    [ "esp:GPIO4", "btn1:1.l", "blue", [] ],
    [ "btn1:2.l", "esp:GND.7", "black", [] ],
    [ "esp:3V3", "led1:A", "red", [] ]
  ]
